{
  "name": "digitalghuru-promotional-pages",
  "private": true,
  "version": "1.0.0",
  "description": "DigitalGhuru promotional web applications workspace",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:kids": "npm --prefix apps/kids run dev",
    "dev:dm": "npm --prefix apps/digital-marketing run dev",
    "dev:marketing": "npm --prefix apps/digital-marketing run dev",
    "build:kids": "npm --prefix apps/kids run build",
    "build:dm": "npm --prefix apps/digital-marketing run build",
    "build:marketing": "npm --prefix apps/digital-marketing run build",
    "build": "npm run build:kids && npm run build:dm",
    "preview:kids": "npm --prefix apps/kids run preview",
    "preview:dm": "npm --prefix apps/digital-marketing run preview",
    "lint:kids": "npm --prefix apps/kids run lint"
  }
}

